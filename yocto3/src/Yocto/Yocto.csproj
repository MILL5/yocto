<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>yocto</PackageId>
    <Title>yocto — the tiny IoC container for .NET 10</Title>
    <Description>yocto is a tiny, open-source IoC / dependency injection container for .NET 10. A drop-in IServiceProvider for ASP.NET Core and Microsoft.Extensions.DependencyInjection (passes Microsoft's DI specification tests) with keyed services, open generics, scopes, child containers, per-thread and pooled lifetimes, modules, build-time validation, and Native AOT support.</Description>
    <PackageTags>ioc;ioc-container;di;dependency-injection;dependencyinjection;inversion-of-control;iserviceprovider;keyed-services;open-generics;aspnetcore;native-aot;lightweight;autofac-alternative;dotnet;mill5</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>yocto.png</PackageIcon>
    <PackageReleaseNotes>yocto 3: a ground-up rewrite for .NET 10. Microsoft.Extensions.DependencyInjection drop-in (keyed services, open generics, scopes), async disposal, validation, Native AOT annotations.</PackageReleaseNotes>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsAotCompatible>true</IsAotCompatible>
    <!-- Public API docs are terse by design; don't fail builds over missing XML comments. -->
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\docs\assets\yocto.png" Pack="true" PackagePath="\" />
    <InternalsVisibleTo Include="Yocto.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="11.0.0" />
  </ItemGroup>

</Project>
